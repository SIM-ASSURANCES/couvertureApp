generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  // Super-administrateur scopé à une seule branche (voir Admin.branches) —
  // mêmes pouvoirs qu'un SUPER_ADMIN global mais limités à sa/ses branche(s).
  BRANCH_SUPER_ADMIN
  SUPER_ADMIN
}

enum TypeCommerce {
  Electronique
  Vulcanisateur
  MecaniqueGarage
  AccessoireAuto
}

enum StatutPartenaire {
  actif
  inactif
}

// --- API partenaire (accès serveur-à-serveur au catalogue + souscriptions) ---

// Canal par lequel une souscription est entrée : parcours normal (QR public,
// espaces admin/agent) ou API partenaire. `api` implique que l'encaissement est
// fait par le partenaire lui-même (option B) : la couverture n'est activée
// qu'après POST /api/partner/v1/souscriptions/:id/confirmer-paiement.
enum CanalVente {
  direct
  api
}

// `test` : clé de bac à sable — souscriptions non facturées / exclues des stats
// et des commissions (phase 2). `live` : production.
enum EnvApiKey {
  live
  test
}

enum StatutApiKey {
  active
  revoquee
}

enum StatutIncendie {
  en_cours
  complet
  expire
}

enum WaveStatut {
  en_attente
  confirme
  echoue
}

enum StatutDossier {
  paye_formulaire_attente
  complet
}

enum TypeAction {
  creation
  modification
  suppression
  export
  connexion
  relance
}

enum StatutDemande {
  en_attente
  validee
  rejetee
}

enum Branche {
  INCENDIE_ACCIDENT
  RELAX
  IMF
  // Branche « IMF Partenaires » — gestion multi-IMF : l'admin enregistre
  // autant d'institutions de microfinance qu'il veut, chacune avec son
  // paramétrage propre. Voir model Imf et routes/imfPartenaires.ts.
  IMF_PARTENAIRES
}

enum RoleImf {
  AGENT
  RESPONSABLE_AGENCE
  // Responsable d'une seule zone — accès complet (simulateur, contrats,
  // sinistres) en plus de la supervision de son réseau. Rattaché via le
  // champ scalaire `zoneId` (une seule zone, sélection par menu déroulant).
  RESPONSABLE_ZONE
  // Chef de zone — supervise la production de PLUSIEURS zones à la fois
  // (rattaché via la relation `zones`, cases à cocher côté admin). Rôle
  // volontairement restreint : ni simulateur, ni déclaration de sinistres,
  // ni commissions — uniquement la vue d'ensemble de la production.
  CHEF_ZONE
  // Rattaché à une agence comme RESPONSABLE_AGENCE, mais accès restreint
  // (tableau de bord, souscriptions, contrats, finance) et seul rôle à voir
  // les commissions générées par l'agence — le responsable ne les voit pas.
  FINANCE_COMPTABLE
}

enum TypePaiement {
  FACTURE
  WAVE
}

enum StatutSouscription {
  en_cours
  complet
  expire
}

// Deux formules seulement (RelaxMoto/RelaxAuto) : chaque TarifProduit (via
// libelleVariante = "annuel" | "mensuel") porte le montant PAR échéance
// directement — le mensuel n'est pas la prime annuelle divisée, c'est un
// montant fixe indépendant (payer mensuellement coûte plus cher au total,
// c'est le surcoût de flexibilité).
enum CycleFacturation {
  mensuel
  annuel
}

enum StatutAbonnement {
  actif
  suspendu
  expire
  resilie
}

enum StatutEcheance {
  en_attente
  paye
  echoue
}

enum TypeDocument {
  CNI
  Permis
  Passeport
  Selfie
}

enum StatutValidationDocument {
  en_attente
  valide
  rejete
}

enum StatutCarte {
  generee
  envoyee
  activee
}

model Admin {
  id               String            @id @default(uuid())
  nom              String
  email            String            @unique
  passwordHash     String
  role             Role              @default(ADMIN)
  // Branches auxquelles l'admin a accès (Assurances Incendie/Accident et/ou Relax).
  // Défaut = les deux, pour ne pas retirer l'accès aux comptes déjà existants
  // au moment de l'introduction de ce champ. Un SUPER_ADMIN a toujours accès
  // aux deux branches, quel que soit le contenu de cette colonne (voir auth.ts).
  branches         Branche[]         @default([INCENDIE_ACCIDENT, RELAX])
  createdAt        DateTime          @default(now())
  journal          JournalActivite[]
  simulationsImf   SimulationImf[]   @relation("AdminSimulationsImf")
  souscriptionsImf SouscriptionImf[] @relation("AdminSouscriptionsImf")
  sinistresImf     SinistreImf[]     @relation("AdminSinistresImf")
  bordereauxImf    BordereauImf[]    @relation("AdminBordereauxImf")
}

model Partenaire {
  id                  String                 @id @default(uuid())
  nomCommerce         String
  nomResponsable      String
  telephone           String
  // Optionnels pour la branche Relax (RelaxMoto/RelaxAuto), où seuls le nom
  // et prénoms du partenaire comptent — toujours requis pour Incendie/Accident
  // (validation faite côté formulaire admin).
  localisation        String?
  typeCommerce        TypeCommerce?
  produitIncendie     Boolean                @default(false)
  produitAccident     Boolean                @default(false)
  qrIncendie1000Token String?                @unique
  qrIncendie2000Token String?                @unique
  qrAccidentToken     String?                @unique
  statut              StatutPartenaire       @default(actif)
  email               String?                @unique
  passwordHash        String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  incendie            SouscriptionIncendie[]
  accident            SouscriptionAccident[]
  demandes            DemandeCommission[]
  notifications       Notification[]

  // --- Modèle générique (en cours de migration, cf. Produit/QrCode/Souscription) ---
  branche          Branche?
  qrCodes          QrCode[]
  souscriptionsGen Souscription[]

  // Agents de distribution (Incendie/Accident) créés par le partenaire lui-même.
  agents AgentDistribution[]

  // Produits du catalogue générique désactivés spécifiquement pour ce
  // partenaire (en plus de Produit.actif, qui est un interrupteur global) —
  // n'a d'effet que pour un partenaire au QR sélecteur (sousBranche figée ou
  // QR unique) : le produit apparaît grisé et non cliquable dans le chooser
  // public (voir construireChooserProduits, routes/public.ts), et toute
  // tentative de souscription directe à ce produit pour ce partenaire est
  // rejetée côté serveur (voir produitDesactivePourPartenaire).
  produitsDesactives Produit[] @relation("ProduitsDesactivesPartenaire")

  // Clés d'accès à l'API partenaire (au plus une active à la fois — contrainte
  // applicative, voir routes/partenaires.ts). Générées uniquement par un
  // super-administrateur de la branche INCENDIE_ACCIDENT.
  apiKeys PartnerApiKey[]

  // Institution de microfinance rattachée (branche IMF_PARTENAIRES) — un
  // Partenaire porte au plus une Imf. Voir routes/imfPartenaires.ts.
  imf Imf?
}

/**
 * Agent de distribution créé par un partenaire (Incendie/Accident) depuis son
 * propre espace — mêmes QR codes qu'un partenaire (1000/2000 pour Incendie,
 * unique pour Accident), générés selon les produits du partenaire parent. Une
 * souscription scannée via le QR d'un agent reste rattachée au partenaire
 * (facturation/commission inchangées) mais porte en plus agentDistributionId
 * pour permettre le suivi par agent.
 */
model AgentDistribution {
  id                         String                 @id @default(uuid())
  partenaireId               String
  partenaire                 Partenaire             @relation(fields: [partenaireId], references: [id], onDelete: Cascade)
  nom                        String
  telephone                  String
  localisation               String?
  // Accès à l'espace agent (connexion par téléphone + mot de passe) — mot de
  // passe généré à la création, communiqué en clair une seule fois au
  // partenaire (jamais stocké ni renvoyé en clair ensuite), modifiable par
  // l'agent depuis son espace.
  passwordHash               String?
  // true à la création et après toute réinitialisation par le partenaire —
  // force l'agent à choisir son propre mot de passe avant d'accéder au reste
  // de son espace ; repassé à false dès qu'il change son mot de passe.
  forcerChangementMotDePasse Boolean                @default(true)
  statut                     StatutPartenaire       @default(actif)
  qrIncendie1000Token        String?                @unique
  qrIncendie2000Token        String?                @unique
  qrAccidentToken            String?                @unique
  // Part (fraction décimale) de la commission qui revient à CET agent sur ses
  // propres ventes — le reste (1 - tauxCommissionAgent) revient au partenaire.
  // Par défaut 0,75 (l'agent touche 75 %, le partenaire 25 %), réglable par le
  // partenaire depuis son espace pour chaque agent. La commission totale reste
  // celle générée par la vente (taux produit × prime nette) — cette valeur ne
  // fait que la répartir. Voir services/commission.ts.
  tauxCommissionAgent        Float                  @default(0.75)
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  incendie                   SouscriptionIncendie[]
  accident                   SouscriptionAccident[]
  demandes                   DemandeCommission[]
  qrCodesGeneriques          QrCode[]
  souscriptionsGeneriques    Souscription[]
}

model SouscriptionIncendie {
  id                  String             @id @default(uuid())
  partenaireId        String
  partenaire          Partenaire         @relation(fields: [partenaireId], references: [id], onDelete: Cascade)
  // Renseigné uniquement si la souscription vient du QR d'un agent de
  // distribution (plutôt que du QR du partenaire lui-même).
  agentDistributionId String?
  agentDistribution   AgentDistribution? @relation(fields: [agentDistributionId], references: [id], onDelete: SetNull)
  telephone           String
  nom                 String?
  prenom              String?
  email               String?
  refFacture          String?            @map("numeroFacture")
  ville               String?
  commune             String?
  quartier            String?
  numeroMaison        String?
  // Montant de l'achat déclaré par le client (traçabilité) — a déterminé la
  // formule (1000/2000) côté serveur lors de la souscription via le QR
  // sélecteur (seuil 250 000 FCFA). Non renseigné pour les souscriptions via
  // un ancien QR dédié à une formule précise.
  montantAchat        Int?
  pieceIdentiteUrl    String?
  dateNaissance       DateTime?
  // data URL PNG (selfie) — capturée avec pieceIdentiteUrl pour établir la
  // carte virtuelle de prise en charge, à la complétion du formulaire.
  selfieUrl           String?
  montantPrime        Int                @default(1000)
  capitalGaranti      Int                @default(250000)
  commissionCalculee  Float?
  statut              StatutIncendie     @default(en_cours)
  lienFormulaireToken String?            @unique
  whatsappEnvoyeAt    DateTime?
  relanceCount        Int                @default(0)
  signature           String? // data URL PNG, capturée à la complétion du formulaire
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  // --- Échéance + renouvellement (3 mois, comme Accident et les produits
  // génériques à formule unique) — couverture activée à la complétion du
  // formulaire (statut "complet"), pas de paiement Wave pour ce produit (payé
  // via réf.facture à l'achat) : le renouvellement renvoie donc un lien de
  // COMPLÉTION (nouvelle réf.facture requise), pas un lien de paiement — voir
  // routes/public.ts PATCH /souscriptions/incendie/:token.
  dateDebut                   DateTime?
  dateFin                     DateTime?
  renouvellementEnCoursDepuis DateTime?
  renouveleAt                 DateTime?
  relanceRenouvellementCount  Int       @default(0)
  nombrePaiements             Int       @default(1)

  // Accès espace client (voir Souscription.clientPasswordHash) — posé à la
  // première complétion réussie du formulaire (statut "complet").
  clientPasswordHash String?
  sinistres          SinistreRelax[]

  // --- Canal API partenaire (voir Souscription) ---
  canalVente                  CanalVente @default(direct)
  apiKeyId                    String?
  montantCommissionApi        Int?
  montantAReverser            Int?
  referencePaiementPartenaire String?

  // Voir la note sur Souscription.@@index ci-dessus — mêmes filtres (statut,
  // partenaireId, createdAt/dateFin) sur cette table historique.
  @@index([statut, createdAt])
  @@index([partenaireId, createdAt])
  @@index([dateFin])
}

model SouscriptionAccident {
  id                   String             @id @default(uuid())
  partenaireId         String
  partenaire           Partenaire         @relation(fields: [partenaireId], references: [id], onDelete: Cascade)
  // Renseigné uniquement si la souscription vient du QR d'un agent de
  // distribution (plutôt que du QR du partenaire lui-même).
  agentDistributionId  String?
  agentDistribution    AgentDistribution? @relation(fields: [agentDistributionId], references: [id], onDelete: SetNull)
  telephone            String
  nom                  String
  prenom               String
  dateNaissance        DateTime?
  // Photo pièce d'identité (CNI/Permis) + selfie (data URL PNG/JPEG) — pour
  // établir la carte virtuelle de prise en charge, après confirmation du paiement.
  pieceIdentiteUrl     String?
  selfieUrl            String?
  montantPrime         Int
  capitalGaranti       Int                @default(100000)
  commissionCalculee   Float?
  waveNumero           String?
  waveTransactionId    String?
  waveStatut           WaveStatut         @default(en_attente)
  numeroPolice         String?            @unique
  dateDebut            DateTime?
  dateFin              DateTime?
  statutDossier        StatutDossier      @default(paye_formulaire_attente)
  formulaireComplement Json?
  whatsappEnvoyeAt     DateTime?
  relanceCount         Int                @default(0)
  signature            String? // data URL PNG, capturée avant le paiement Wave
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  // --- Renouvellement (2 semaines avant dateFin) ---
  // Un client (nom, dateNaissance) ne peut souscrire qu'une seule fois — voir
  // la vérification applicative dans POST /public/souscriptions/accident/initiate
  // (pas de contrainte @@unique ici, qui interdirait aussi le renouvellement).
  // Le renouvellement met à jour CETTE MÊME ligne (dateDebut/dateFin prolongés,
  // numeroPolice conservé) plutôt que d'en créer une nouvelle — voir
  // services/accident.ts::confirmerAccident.
  // Horodatage du dernier paiement de renouvellement initié (relance admin),
  // effacé une fois confirmé ou échoué — signale au webhook Wave qu'un
  // paiement est en cours même si waveStatut reste "confirme" (la couverture
  // en cours n'est jamais interrompue pendant l'attente du renouvellement).
  renouvellementEnCoursDepuis DateTime?
  // Horodatage de la dernière confirmation de renouvellement réussie (null
  // tant qu'aucun renouvellement n'a eu lieu).
  renouveleAt                 DateTime?
  relanceRenouvellementCount  Int       @default(0)
  // Nombre de paiements CONFIRMÉS sur cette ligne (1 = souscription initiale
  // seule, 2 = une fois renouvelée, etc.) — puisque le renouvellement met à
  // jour la même ligne plutôt que d'en créer une nouvelle, la commission
  // (services/commission.ts) pondère par ce compteur au lieu de compter les
  // lignes, pour qu'un renouvellement génère bien une commission au partenaire.
  nombrePaiements             Int       @default(1)

  // Accès espace client (voir Souscription.clientPasswordHash) — posé à la
  // première confirmation de paiement.
  clientPasswordHash String?
  sinistres          SinistreRelax[]

  // --- Canal API partenaire (voir Souscription) ---
  canalVente                  CanalVente @default(direct)
  apiKeyId                    String?
  montantCommissionApi        Int?
  montantAReverser            Int?
  referencePaiementPartenaire String?

  // Voir la note sur Souscription.@@index plus haut.
  @@index([waveStatut, createdAt])
  @@index([partenaireId, createdAt])
  @@index([dateFin])
}

model JournalActivite {
  id          String     @id @default(uuid())
  adminId     String?
  admin       Admin?     @relation(fields: [adminId], references: [id], onDelete: SetNull)
  typeAction  TypeAction
  objetType   String
  objetId     String?
  ip          String?
  valeurAvant Json?
  valeurApres Json?
  createdAt   DateTime   @default(now())

  // Table qui grossit à chaque action admin dans toute l'app (dizaines
  // d'appels logAction) ; GET /journal trie toujours par createdAt et filtre
  // souvent sur typeAction/objetType (audit perf 2026-09-11 — aucun index
  // n'existait, chaque affichage du journal d'audit imposait un tri complet).
  @@index([createdAt])
  @@index([typeAction, createdAt])
  @@index([objetType, createdAt])
}

model DemandeCommission {
  id                  String             @id @default(uuid())
  partenaireId        String
  partenaire          Partenaire         @relation(fields: [partenaireId], references: [id], onDelete: Cascade)
  // Renseigné uniquement si la demande vient d'un agent de distribution (et
  // non du partenaire lui-même) : validée par l'admin comme les demandes
  // partenaire, mais porte sur la commission de l'agent — les souscriptions
  // qu'il a apportées sont exclues du calcul de commission due du partenaire
  // (paiement direct à l'agent, pas de double comptage).
  agentDistributionId String?
  agentDistribution   AgentDistribution? @relation(fields: [agentDistributionId], references: [id], onDelete: Cascade)
  montant             Float
  statut              StatutDemande      @default(en_attente)
  periodeDebut        DateTime?
  periodeFin          DateTime?
  traiteePar          String?
  traiteeAt           DateTime?
  motifRejet          String?
  createdAt           DateTime           @default(now())
}

model Notification {
  id           String      @id @default(uuid())
  cible        String
  partenaireId String?
  partenaire   Partenaire? @relation(fields: [partenaireId], references: [id], onDelete: Cascade)
  // Branche concernée (notifications admin uniquement) : permet à chaque
  // admin de ne voir que les notifications de ses branches. Nullable pour ne
  // jamais masquer les notifications déjà existantes avant l'introduction de
  // ce champ, ni une éventuelle notification transverse future.
  branche      Branche?
  type         String
  titre        String
  message      String
  lien         String?
  lu           Boolean     @default(false)
  createdAt    DateTime    @default(now())

  @@index([cible, partenaireId, lu])
}

model Parametre {
  id                              Int   @id @default(1)
  // Taux de commission (décimal) appliqué sur la prime NETTE (HT) des
  // souscriptions — Incendie/Accident historiques ici, produits du modèle
  // générique via Produit.tauxCommission. 0,20 par défaut pour les deux
  // (aligné sur la règle « 20 % de la prime nette »).
  tauxCommissionIncendie          Float @default(0.20)
  tauxCommissionAccident          Float @default(0.20)
  tauxCommissionMensuelleIncendie Float @default(0.10)
  primeAccident                   Int   @default(2000)
  primeHtIncendie1000             Float @default(800)
  primeHtIncendie2000             Float @default(1600)
  // Taux de commission « canal API » (décimal, ex. 0.10 = 10%) appliqué sur la
  // prime HT quand une souscription passe par l'API partenaire et que le
  // produit concerné n'a pas de taux dédié (Produit.tauxCommissionApi). Sert
  // aussi de repli pour les produits historiques Incendie/Accident.
  tauxCommissionApiDefaut         Float @default(0.10)
}

model TarifAccident {
  id             Int      @id @default(autoincrement())
  prime          Int      @unique
  primeHT        Float?
  fg             Float?
  taxes          Float?
  capitalGaranti Int
  commission     Float
  createdAt      DateTime @default(now())
}

model TarifIncendie {
  id             Int      @id @default(autoincrement())
  prime          Int      @unique
  primeHT        Float?
  fg             Float?
  taxes          Float?
  capitalGaranti Int
  commission     Float
  createdAt      DateTime @default(now())
}

// =====================================================================
// Modèle générique Produit / Branche — cible de la migration en cours.
// Coexiste avec les modèles historiques ci-dessus le temps de la bascule
// (voir backend/scripts/migrate-produits.ts). Incendie et Accident restent
// la source de vérité tant que les routes ne sont pas migrées ; RelaxMoto
// et RelaxAuto sont créés directement sur ce modèle générique.
// =====================================================================

model Produit {
  id                    String         @id @default(uuid())
  code                  String         @unique // "incendie" | "accident" | "relaxmoto" | "relaxauto"
  libelle               String
  branche               Branche
  // Regroupement purement présentationnel (nav/catalogue) au sein d'une
  // branche pouvant contenir plusieurs produits hétérogènes — ex.
  // "ASSURANCES_ACCIDENTS" / "ASSURANCES_DOMMAGES" au sein de INCENDIE_ACCIDENT.
  // Ne remplace pas `branche`, qui reste la frontière de permissions.
  sousBranche           String?
  typePaiement          TypePaiement
  couleurQr             String         @default("#004b9c")
  actif                 Boolean        @default(true)
  ordre                 Int            @default(0)
  createdAt             DateTime       @default(now())
  // Taux de commission (décimal, ex. 0.20 = 20%) pour un produit à devis
  // calculé dynamiquement (RelaxAccidents générale, SecurHome+) — ces
  // produits n'ont pas de TarifProduit (donc pas de commission par formule),
  // le taux s'applique directement sur la prime nette HT calculée à la
  // souscription (voir services/commission.ts).
  tauxCommission        Float?
  // Taux de commission « canal API » (décimal) propre à ce produit, appliqué
  // sur la prime HT des souscriptions entrées via l'API partenaire. Prioritaire
  // sur Parametre.tauxCommissionApiDefaut. Null → repli sur le taux global.
  tauxCommissionApi     Float?
  tarifs                TarifProduit[]
  qrCodes               QrCode[]
  souscriptions         Souscription[]
  partenairesDesactives Partenaire[]   @relation("ProduitsDesactivesPartenaire")
}

model TarifProduit {
  id                      Int      @id @default(autoincrement())
  produitId               String
  produit                 Produit  @relation(fields: [produitId], references: [id], onDelete: Cascade)
  libelleVariante         String? // ex: "1000"/"2000" pour incendie, null sinon
  prime                   Int
  primeHT                 Float?
  fg                      Float?
  taxes                   Float?
  capitalGaranti          Int
  commission              Float
  tauxCommissionMensuelle Float?
  // Garanties additionnelles propres à une formule, en plus de capitalGaranti
  // (ex. RelaxVoyage : { fraisSante, bagages } — capitalGaranti porte le
  // montant Décès/IPT, seule valeur déjà affichée partout ailleurs).
  donneesSpecifiques      Json?
  createdAt               DateTime @default(now())

  // Identité d'une variante = (produit, libellé), pas (produit, prime) : deux
  // garanties d'un même produit peuvent légitimement partager le même prix
  // (ex. COUPS DURS fusionné : "deces" et "plafond_500000" valent tous deux
  // 4 000 FCFA). Anciennement unique sur (produitId, prime).
  @@unique([produitId, libelleVariante])
}

model QrCode {
  id                  String             @id @default(uuid())
  partenaireId        String
  partenaire          Partenaire         @relation(fields: [partenaireId], references: [id], onDelete: Cascade)
  // Renseigné uniquement si ce QR appartient à un agent de distribution du
  // partenaire (plutôt qu'au partenaire lui-même) — même principe que
  // AgentDistribution.qrIncendie1000Token pour le modèle historique.
  agentDistributionId String?
  agentDistribution   AgentDistribution? @relation(fields: [agentDistributionId], references: [id], onDelete: Cascade)
  // Un QR pointe SOIT sur un produit précis (produitId, comportement
  // historique : le prospect arrive directement sur son formulaire), SOIT sur
  // une sous-branche entière (sousBranche, "QR sélecteur" — un seul QR par
  // partenaire/Assurance, le prospect choisit son produit après le scan).
  // Exactement un des deux est renseigné (contrainte applicative, pas SQL).
  produitId           String?
  produit             Produit?           @relation(fields: [produitId], references: [id])
  sousBranche         String?
  libelleVariante     String? // distingue plusieurs QR pour un même produit (ex incendie 1000/2000)
  token               String             @unique
  actif               Boolean            @default(true)
  createdAt           DateTime           @default(now())

  // NULL et une valeur donnée sont considérés distincts par Postgres pour un
  // index unique — deux lignes agentDistributionId=NULL (partenaire) et
  // agentDistributionId=X (agent) peuvent donc coexister sur le même
  // (partenaireId, produitId, libelleVariante) sans collision. Un QR sélecteur
  // (produitId=NULL) n'est pas couvert par cet index (produitId toujours NULL
  // pour toutes ces lignes) : l'unicité pratique vient de `token` (@unique).
  @@unique([partenaireId, agentDistributionId, produitId, libelleVariante])
}

model Souscription {
  id                   String             @id @default(uuid())
  produitId            String
  produit              Produit            @relation(fields: [produitId], references: [id])
  partenaireId         String
  partenaire           Partenaire         @relation(fields: [partenaireId], references: [id], onDelete: Cascade)
  // Renseigné uniquement si la souscription vient du QR d'un agent de
  // distribution (plutôt que du QR du partenaire lui-même) — même principe
  // que SouscriptionIncendie/SouscriptionAccident.agentDistributionId.
  agentDistributionId  String?
  agentDistribution    AgentDistribution? @relation(fields: [agentDistributionId], references: [id], onDelete: SetNull)
  telephone            String
  nom                  String?
  prenom               String?
  email                String?
  dateNaissance        DateTime?
  // Affiché sur la carte de prise en charge (refonte Novelia) — collecté
  // uniquement pour les produits qui génèrent cette carte (Frais Médicaux,
  // RelaxMoto/Auto, RelaxVoyage), pas pour Incendie.
  sexe                 Sexe?
  commune              String?
  quartier             String?
  numeroMaison         String?
  pieceIdentiteUrl     String?
  montantPrime         Int
  capitalGaranti       Int
  commissionCalculee   Float?
  refFacture           String? // paiement FACTURE (ex incendie)
  waveNumero           String? // paiement WAVE
  waveTransactionId    String?
  waveStatut           WaveStatut?
  numeroPolice         String?            @unique
  dateDebut            DateTime?
  dateFin              DateTime?
  statut               StatutSouscription @default(en_cours)
  lienFormulaireToken  String?            @unique
  formulaireComplement Json?
  // Champs propres à un produit donné, hors colonnes fixes ci-dessus (ex.
  // Profession, Compagnie, Lieu de départ/arrivée, Numéro Ticket...) —
  // validés par un schéma zod dédié à `produit.code`, sur le modèle de
  // SouscriptionImf.entrees côté IMF.
  donneesSpecifiques   Json?
  // Détail du devis calculé (lignes par garantie + totaux), pour un produit à
  // calcul dynamique (ex. RelaxAccidents générale) — évite de recalculer pour
  // le réaffichage sur le contrat. Même répartition entrées/résultat que
  // SimulationImf.entrees/resultat côté IMF.
  resultat             Json?
  whatsappEnvoyeAt     DateTime?
  relanceCount         Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  // --- Abonnement récurrent (RelaxMoto/RelaxAuto : paiement en plusieurs échéances) ---
  cycleFacturation CycleFacturation?
  statutAbonnement StatutAbonnement?
  nombreEcheances  Int?
  // RelaxMoto/RelaxAuto : nombre de cycles souscrits d'avance (2 = deux mois
  // ou deux ans selon `cycleFacturation`). La prime enregistrée est déjà le
  // total payé (tarif du cycle × nombrePeriodes) et la couverture court sur
  // toute la durée — voir services/paiementWave.ts::confirmerEcheance.
  nombrePeriodes   Int               @default(1)
  paiements        Paiement[]
  documents        Document[]
  carte            Carte?

  // --- Espace client (RelaxMoto/RelaxAuto) : créé automatiquement à la
  // confirmation du 1er paiement, permet au client de se reconnecter pour
  // renouveler son contrat ou déclarer un sinistre. Identifiant = téléphone,
  // mot de passe généré et envoyé par SMS.
  clientPasswordHash String?
  sinistres          SinistreRelax[]

  // --- Renouvellement admin (produits à formule unique, 3 mois, SANS
  // cycleFacturation : RelaxAccidents Frais Médicaux/générale, RelaxVoyage,
  // SecurHome+, SecurPro Dommages) — RelaxMoto/RelaxAuto gardent leur propre
  // renouvellement côté espace client (cycleFacturation non-null), ces champs
  // n'y sont pas utilisés. Un client (nom, dateNaissance) ne peut souscrire
  // qu'une seule fois — voir vérification applicative dans public.ts. Le
  // renouvellement crée une nouvelle échéance (Paiement, estRenouvellement:
  // true) sur CETTE MÊME souscription plutôt qu'une nouvelle ligne — voir
  // services/paiementWave.ts::confirmerEcheance.
  renouvellementEnCoursDepuis DateTime?
  renouveleAt                 DateTime?
  relanceRenouvellementCount  Int       @default(0)
  // Nombre de paiements confirmés (1er + renouvellements) — la commission
  // (services/commission.ts) pondère par ce compteur plutôt que par ligne,
  // pour qu'un renouvellement génère une commission au partenaire.
  nombrePaiements             Int       @default(1)

  // --- Canal API partenaire (option B : le partenaire encaisse) ---
  // `direct` = parcours normal ; `api` = créée via l'API partenaire, en
  // attente de POST .../confirmer-paiement. `montantCommissionApi` (part
  // partenaire, figée à la création depuis Produit.tauxCommissionApi ou le
  // taux global) et `montantAReverser` (= montantPrime - montantCommissionApi)
  // ne sont renseignés que pour `canalVente = api`.
  canalVente                  CanalVente @default(direct)
  apiKeyId                    String?
  montantCommissionApi        Int?
  montantAReverser            Int?
  referencePaiementPartenaire String?

  // --- Analyse anti-fraude IA (souscriptions canal API uniquement) ---
  // Lancée en fire-and-forget à la création (services/fraudeIA.ts::
  // analyserSouscriptionApiIA) : compare pièce d'identité ↔ selfie ↔ identité
  // déclarée via OpenRouter. Purement indicative — ne bloque ni ne rejette
  // jamais la souscription, sert d'alerte de revue côté admin.
  // `niveauRisqueIA` (faible|moyen|eleve) est dénormalisé depuis
  // `analyseIA.niveauRisque` pour le filtrage ; null si l'analyse a échoué.
  analyseIA      Json?
  analyseIAAt    DateTime?
  niveauRisqueIA String?

  // Index ajoutés (2026-09-04) pour le Tableau de bord et la page Contrats
  // admin — ces requêtes filtrent quasi systématiquement par produitId/
  // waveStatut/partenaireId et trient par createdAt ; sans index, chacune
  // déclenchait un balayage complet de la table à chaque chargement de page.
  @@index([produitId, waveStatut, createdAt])
  @@index([partenaireId, createdAt])
  @@index([dateDebut])
  @@index([dateFin])
}

/**
 * Échéance d'un abonnement récurrent (RelaxMoto/RelaxAuto). `TarifProduit.prime`
 * est le montant PAR échéance pour le cycle choisi (mensuel/annuel) — jamais
 * une prime annuelle divisée, voir echeancier.ts.
 */
model Paiement {
  id                String         @id @default(uuid())
  souscriptionId    String
  souscription      Souscription   @relation(fields: [souscriptionId], references: [id], onDelete: Cascade)
  numeroEcheance    Int
  montant           Int
  statut            StatutEcheance @default(en_attente)
  dateEcheance      DateTime
  datePaiement      DateTime?
  waveTransactionId String?
  // Paiement de renouvellement (RelaxMoto/Auto : depuis l'espace client ;
  // formule unique : relance admin) plutôt qu'échéance du cycle initial —
  // confirmerEcheance prolonge alors juste dateFin (1 an ou 3 mois selon le
  // produit), sans reproduire la logique de première activation.
  estRenouvellement Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([souscriptionId, numeroEcheance])
  // GET /relax/echeances (page "Paiements en attente") filtre par statut et
  // trie par dateEcheance (audit perf 2026-09-11).
  @@index([statut, dateEcheance])
}

model Document {
  id               String                   @id @default(uuid())
  souscriptionId   String
  souscription     Souscription             @relation(fields: [souscriptionId], references: [id], onDelete: Cascade)
  type             TypeDocument
  url              String
  statutValidation StatutValidationDocument @default(en_attente)
  motifRejet       String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
}

/**
 * Carte de prise en charge — génération via NOVELIA (mode stub tant que l'API n'est pas branchée)
 */
model Carte {
  id                 String       @id @default(uuid())
  souscriptionId     String       @unique
  souscription       Souscription @relation(fields: [souscriptionId], references: [id], onDelete: Cascade)
  numero             String       @unique
  statut             StatutCarte  @default(generee)
  noveliaRef         String?
  dateGeneration     DateTime     @default(now())
  dateEnvoi          DateTime?
  dateActivation     DateTime?
  dateRenouvellement DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

enum StatutSinistreRelax {
  declare
  en_cours
  traite
  rejete
}

/**
 * Déclaration de sinistre par un client depuis son espace personnel — pour
 * n'importe quel produit (modèle générique, Incendie ou Accident historique,
 * voir refonte "espace client universel"), d'où trois FK optionnelles dont
 * une seule est renseignée selon `produitType` (Prisma ne modélise pas
 * nativement une relation polymorphe) plutôt qu'une référence non typée.
 */
model SinistreRelax {
  id                     String                @id @default(uuid())
  produitType            String // "generique" | "incendie" | "accident"
  souscriptionId         String?
  souscription           Souscription?         @relation(fields: [souscriptionId], references: [id], onDelete: Cascade)
  souscriptionIncendieId String?
  souscriptionIncendie   SouscriptionIncendie? @relation(fields: [souscriptionIncendieId], references: [id], onDelete: Cascade)
  souscriptionAccidentId String?
  souscriptionAccident   SouscriptionAccident? @relation(fields: [souscriptionAccidentId], references: [id], onDelete: Cascade)
  numeroSinistre         String                @unique
  typeEvenement          String
  dateSurvenance         DateTime
  description            String?
  photosAccidentUrls     String[]              @default([])
  statut                 StatutSinistreRelax   @default(declare)
  motifRejet             String?
  // Analyse anti-fraude IA (OpenRouter) — voir services/fraudeIA.ts. Purement
  // indicative : ne bloque jamais, ni n'automatise la décision finale (voir
  // PATCH .../sinistres/:id/statut, toujours déclenché manuellement par l'admin).
  analyseIA              Json?
  analyseIAAt            DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
}

// --- Branche IMF : hiérarchie Zone -> Agence -> Agent (distribution par agent, pas par QR) ---

// =====================================================================
// Branche « IMF Partenaires » — chaque IMF partenaire est une institution
// de microfinance enregistrée par l'admin, rattachée 1:1 à un Partenaire,
// avec son paramétrage propre (produits & garanties, barèmes/tarifs + taux
// de commission, documents/branding + habilitations — livrés par phases).
//
// Voie « multi-tenant » : les entités opérationnelles IMF (Zone/Agence/Agent/
// Simulation/Souscription/Sinistre/Bordereau) portent un `imfId` NULLABLE :
//   - null            → branche « Assurances IMF » historique (mono-IMF)
//   - renseigné       → IMF partenaire de la branche IMF_PARTENAIRES
// Le filtrage par périmètre IMF est branché phase par phase (cf. plan).
// Voir routes/imfPartenaires.ts.
// =====================================================================
model Imf {
  id                String           @id @default(uuid())
  // Slug stable, dérivé du nom à la création (unicité garantie côté route).
  code              String           @unique
  nom               String
  partenaireId      String           @unique
  partenaire        Partenaire       @relation(fields: [partenaireId], references: [id], onDelete: Cascade)
  statut            StatutPartenaire @default(actif)
  // Branding repris sur les documents et l'espace dédié de l'IMF (phase 4).
  logoUrl           String?
  couleurPrimaire   String?
  couleurSecondaire String?
  mentionsLegales   String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  zones         ZoneImf[]
  agences       AgenceImf[]
  agents        AgentImf[]
  simulations   SimulationImf[]
  souscriptions SouscriptionImf[]
  sinistres     SinistreImf[]
  bordereaux    BordereauImf[]

  // Paramétrage par IMF (phase 2).
  produits           ImfProduit[]
  baremesSecurpro    ImfBaremeSecurpro[]
  baremesSecurstock  ImfBaremeSecurstock[]
  paliersSecurecolte ImfPalierSecurecolte[]
  tarifsFixes        ImfTarifFixe[]
  documents          ImfDocumentModele[]
}

/**
 * Produit IMF activé pour une IMF partenaire, avec ses surcharges propres.
 * Une ligne par (imf, code) provisionnée à la création de l'IMF depuis
 * CATALOGUE_PRODUITS_IMF (services/cataloguesImf.ts). Le moteur de tarification
 * / simulation ne la consomme qu'à partir de la phase 3.
 */
model ImfProduit {
  id        String   @id @default(uuid())
  imfId     String
  imf       Imf      @relation(fields: [imfId], references: [id], onDelete: Cascade)
  // "securpro" | "securstock" | "coupsdurs" | "securecolte"
  code      String
  actif     Boolean  @default(true)
  // Surcharges par garantie : [{ code, libelle, actif, plafond }] — copiées du
  // catalogue de référence à la création, éditables ensuite.
  garanties Json
  // Plafond de capital global pour ce produit chez cette IMF (null = barème).
  plafond   Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([imfId, code])
  @@index([imfId])
}

/**
 * Barèmes / tarifs par IMF (phase 2b). Provisionnés à la création de l'IMF en
 * copiant les valeurs *live* des tables globales (BaremeSecurpro/…), avec repli
 * sur services/baremesImfDefaut.ts. Édités depuis la fiche IMF, onglet
 * « Barèmes & tarifs ». Consommés par le moteur de tarification à partir de la
 * phase 3.
 */
model ImfBaremeSecurpro {
  id             String   @id @default(uuid())
  imfId          String
  imf            Imf      @relation(fields: [imfId], references: [id], onDelete: Cascade)
  classe         Int // 1..4
  limiteCapital  Int
  tauxIncendie   Float
  tauxCommission Float    @default(0.20)
  updatedAt      DateTime @updatedAt

  @@unique([imfId, classe])
  @@index([imfId])
}

model ImfBaremeSecurstock {
  id                    String   @id @default(uuid())
  imfId                 String
  imf                   Imf      @relation(fields: [imfId], references: [id], onDelete: Cascade)
  classe                Int
  limiteCapital         Int
  tauxDommageElectrique Float
  tauxAutreCause        Float
  tauxCommission        Float    @default(0.20)
  updatedAt             DateTime @updatedAt

  @@unique([imfId, classe])
  @@index([imfId])
}

model ImfPalierSecurecolte {
  id                String   @id @default(uuid())
  imfId             String
  imf               Imf      @relation(fields: [imfId], references: [id], onDelete: Cascade)
  seuil             String // "forte" | "moyenne" | "faible"
  pourcentageIndice Float
  montantIndemnite  Int
  updatedAt         DateTime @updatedAt

  @@unique([imfId, seuil])
  @@index([imfId])
}

model ImfTarifFixe {
  id              String   @id @default(uuid())
  imfId           String
  imf             Imf      @relation(fields: [imfId], references: [id], onDelete: Cascade)
  produitCode     String // "coupsdurs" | "securecolte"
  libelleVariante String
  prime           Int
  primeHT         Float?
  fg              Float?
  taxes           Float?
  capitalGaranti  Int
  commission      Float
  updatedAt       DateTime @updatedAt

  @@unique([imfId, produitCode, libelleVariante])
  @@index([imfId])
}

/**
 * Modèle de document propre à une IMF (phase 2c). Une ligne n'existe que si
 * l'admin a personnalisé le document (mêmes principes que ConditionsGenerales) ;
 * tant qu'aucune ligne n'existe, le rendu retombera sur le document de la
 * branche (câblage phase 3). `cle` ∈ CLES_DOCUMENTS_IMF (services/cataloguesImf.ts).
 */
model ImfDocumentModele {
  id                String   @id @default(uuid())
  imfId             String
  imf               Imf      @relation(fields: [imfId], references: [id], onDelete: Cascade)
  cle               String
  libelle           String
  contenuHtml       String
  modifieParAdminId String?
  updatedAt         DateTime @updatedAt

  @@unique([imfId, cle])
  @@index([imfId])
}

model ZoneImf {
  id           String      @id @default(uuid())
  // Unicité par périmètre : globale pour la branche « Assurances IMF » (imfId
  // null), et par IMF pour « IMF Partenaires ». NB : Postgres considère les
  // NULL comme distincts, donc l'unicité des noms côté branche historique
  // repose aussi sur un contrôle applicatif (routes/imf.ts).
  nom          String
  createdAt    DateTime    @default(now())
  // null = branche IMF historique ; renseigné = IMF partenaire (voir model Imf).
  imfId        String?
  imf          Imf?        @relation(fields: [imfId], references: [id])
  agences      AgenceImf[]
  // Rattachement direct du/des RESPONSABLE_ZONE de cette zone (une seule zone
  // par responsable, via le champ scalaire AgentImf.zoneId).
  agents       AgentImf[]
  // Chefs de zone (CHEF_ZONE) supervisant cette zone parmi d'autres — relation
  // many-to-many, un chef peut couvrir plusieurs zones et une zone peut avoir
  // plusieurs chefs.
  responsables AgentImf[]  @relation("ResponsableZones")

  @@unique([imfId, nom])
  @@index([imfId])
}

model AgenceImf {
  id           String         @id @default(uuid())
  nom          String
  zoneId       String
  zone         ZoneImf        @relation(fields: [zoneId], references: [id])
  telephone    String?
  localisation String?
  createdAt    DateTime       @default(now())
  imfId        String?
  imf          Imf?           @relation(fields: [imfId], references: [id])
  agents       AgentImf[]
  bordereaux   BordereauImf[]

  @@index([imfId])
}

model AgentImf {
  id            String            @id @default(uuid())
  nom           String
  prenom        String
  telephone     String
  email         String            @unique
  passwordHash  String
  roleImf       RoleImf           @default(AGENT)
  agenceId      String? // requis si roleImf = AGENT
  agence        AgenceImf?        @relation(fields: [agenceId], references: [id])
  // Zone unique du RESPONSABLE_ZONE (sélection par menu déroulant).
  zoneId        String?
  zone          ZoneImf?          @relation(fields: [zoneId], references: [id])
  // Zones supervisées par le CHEF_ZONE — plusieurs zones possibles,
  // sélectionnées via cases à cocher côté admin.
  zones         ZoneImf[]         @relation("ResponsableZones")
  statut        StatutPartenaire  @default(actif)
  createdAt     DateTime          @default(now())
  imfId         String?
  imf           Imf?              @relation(fields: [imfId], references: [id])
  simulations   SimulationImf[]
  souscriptions SouscriptionImf[]
  sinistres     SinistreImf[]

  // Lien public de simulation (2026-09-04) — un client peut simuler et
  // souscrire seul via `${APP_PUBLIC_URL}/imf/:token`, sans que l'agent
  // saisisse quoi que ce soit ; la souscription lui est automatiquement
  // rattachée (agentId). Généré à la demande (null tant que l'admin n'a pas
  // cliqué sur "Lien public"), voir GET /imf/agents/:id/qr.
  qrImfToken String? @unique

  @@index([imfId])
}

// --- Phase 2 : moteur de tarification IMF (SECURPRO/SECURSTOCK à formules, COUPS DURS/SECURECOLTE en catalogue fixe) ---

model BaremeSecurpro {
  id             String   @id @default(uuid())
  classe         Int      @unique // 1 à 4
  limiteCapital  Int
  tauxIncendie   Float // taux décimal, ex 0.00072 pour classe 1
  // Taux de commission (décimal, ex. 0.20 = 20%), appliqué sur la prime nette
  // HT de la souscription — pas sur la prime TTC.
  tauxCommission Float    @default(0.20)
  updatedAt      DateTime @updatedAt
}

model BaremeSecurstock {
  id                    String   @id @default(uuid())
  classe                Int      @unique
  limiteCapital         Int
  tauxDommageElectrique Float // T1
  tauxAutreCause        Float // T2
  // Taux de commission (décimal, ex. 0.20 = 20%), appliqué sur la prime nette HT.
  tauxCommission        Float    @default(0.20)
  updatedAt             DateTime @updatedAt
}

model PalierSecurecolte {
  id                String   @id @default(uuid())
  seuil             String // "forte" | "moyenne" | "faible"
  pourcentageIndice Float // borne haute du palier (0.75 / 0.85 / 0.95)
  montantIndemnite  Int
  createdAt         DateTime @default(now())
}

model IndiceArcImf {
  id        String   @id @default(uuid())
  region    String
  annee     Int
  valeur    Float // indice WRSI observé
  reference Float // valeur de référence (médiane 5 ans)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([region, annee])
}

/**
 * Référentiel des sous-préfectures pour le modèle actuariel ARC de
 * SECURECOLTE : sert à recalculer périodiquement le tarif national
 * (SOMMEPROD des indemnités moyennes historiques pondérée par la
 * population agricole / somme des populations agricoles), voir
 * /imf/securecolte/tarif-national. Importé depuis un export du tableur
 * ARC officiel (pas de saisie manuelle ligne par ligne).
 */
model SousPrefectureArc {
  id                 String   @id @default(uuid())
  region             String
  district           String
  sousPrefecture     String   @unique
  populationAgricole Int
  // Indemnité annuelle moyenne historique (XOF), calculée hors appli à
  // partir des déviations WRSI observées 2001-2024 (colonne "Moyenne" du
  // modèle ARC fourni).
  moyenneIndemnite   Float
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model SimulationImf {
  id           String           @id @default(uuid())
  // agentId OU adminId : une simulation est faite soit par un agent du réseau,
  // soit directement par un admin (indépendant de toute zone/agence/agent).
  agentId      String?
  agent        AgentImf?        @relation(fields: [agentId], references: [id])
  adminId      String?
  admin        Admin?           @relation("AdminSimulationsImf", fields: [adminId], references: [id])
  produitCode  String // "securpro" | "securstock" | "coupsdurs" | "securecolte"
  entrees      Json
  resultat     Json
  primeTTC     Int
  createdAt    DateTime         @default(now())
  imfId        String?
  imf          Imf?             @relation(fields: [imfId], references: [id])
  souscription SouscriptionImf?
  // Identifiant généré côté client lors d'une saisie hors-ligne (PWA), utilisé
  // comme clé d'idempotence à la synchronisation : si la requête est rejouée
  // (double tap, coupure réseau après succès), la même simulation est
  // retournée au lieu d'en créer un doublon.
  offlineId    String?          @unique

  @@index([imfId])
}

// --- Phase 3 (réduite) : conversion d'une simulation en souscription ---

enum StatutSouscriptionImf {
  en_cours
  active
  annulee
}

enum Sexe {
  masculin
  feminin
}

enum TypePieceIdentite {
  cni
  passeport
  permis_conduire
}

model SouscriptionImf {
  id              String                @id @default(uuid())
  numeroPolice    String                @unique
  // agentId OU adminId : rattachée à un agent du réseau, ou souscrite
  // directement par un admin (indépendant de toute zone/agence/agent).
  agentId         String?
  agent           AgentImf?             @relation(fields: [agentId], references: [id])
  adminId         String?
  admin           Admin?                @relation("AdminSouscriptionsImf", fields: [adminId], references: [id])
  simulationId    String?               @unique
  simulation      SimulationImf?        @relation(fields: [simulationId], references: [id])
  produitCode     String
  nom             String
  prenom          String
  telephone       String
  email           String?
  typePiece       TypePieceIdentite?
  numeroPiece     String?
  ville           String?
  communeQuartier String?
  // Signature manuscrite du souscripteur (data URL PNG), facultative — capturée
  // au moment de la conversion simulation → souscription, cf. contract.ts.
  signature       String?
  entrees         Json
  resultat        Json
  primeTTC        Int
  statut          StatutSouscriptionImf @default(en_cours)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  imfId           String?
  imf             Imf?                  @relation(fields: [imfId], references: [id])
  sinistres       SinistreImf[]
  // Clé d'idempotence pour la synchronisation hors-ligne (PWA) — voir
  // SimulationImf.offlineId.
  offlineId       String?               @unique

  // audit perf 2026-09-11 : listes/dashboards IMF filtrent en permanence par
  // agentId (in) et par statut, toujours triés par createdAt — jusqu'ici
  // seul imfId était indexé.
  @@index([imfId])
  @@index([agentId, createdAt])
  @@index([statut, createdAt])
}

// --- Phase 6 : sinistres IMF ---

enum StatutSinistreImf {
  declare
  pieces_attente
  complet
  instruction
  accepte
  rejete
  regle
}

model SinistreImf {
  id                  String            @id @default(uuid())
  numeroSinistre      String            @unique
  souscriptionId      String
  souscription        SouscriptionImf   @relation(fields: [souscriptionId], references: [id])
  // Déclarant : un agent du réseau, ou l'admin (souscriptions directes).
  agentId             String?
  agent               AgentImf?         @relation(fields: [agentId], references: [id])
  adminId             String?
  admin               Admin?            @relation("AdminSinistresImf", fields: [adminId], references: [id])
  typeEvenement       String
  dateSurvenance      DateTime
  dateDeclaration     DateTime          @default(now())
  // Checklist des pièces requises pour ce produit/variante, figée au moment de
  // la déclaration : [{ label: string, fournie: boolean }]. Pas d'upload de
  // fichier dans l'appli (aucune infra en place) — l'agent coche après
  // vérification physique des pièces, cohérent avec la distribution en
  // présentiel de la branche IMF.
  pieces              Json
  montantEstime       Int?
  montantRegle        Int?
  // SECURSTOCK uniquement : l'indemnité est versée en priorité à l'IMF nantie
  // jusqu'à épuisement de l'encours du prêt, le solde revient au souscripteur.
  montantIMF          Int?
  montantSouscripteur Int?
  motifRejet          String?
  statut              StatutSinistreImf @default(declare)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  imfId               String?
  imf                 Imf?              @relation(fields: [imfId], references: [id])

  // audit perf 2026-09-11 : filtré par agentId et par statut (dashboards/listes IMF).
  @@index([imfId])
  @@index([agentId])
  @@index([statut])
}

// --- Phase 7 : bordereaux & règlement IMF ---
// Une AgenceImf correspond en pratique à l'agence d'une institution de
// microfinance (IMF) dans ce modèle de données — c'est donc l'unité pour
// laquelle un bordereau de production est émis.

enum StatutBordereauImf {
  emis
  partiellement_regle
  regle
}

model BordereauImf {
  id                  String             @id @default(uuid())
  numero              String             @unique
  agenceId            String
  agence              AgenceImf          @relation(fields: [agenceId], references: [id])
  periodeDebut        DateTime
  periodeFin          DateTime
  // Souscriptions incluses, figées au moment de la génération (append-only :
  // un bordereau émis ne change pas rétroactivement si de nouvelles
  // souscriptions sont créées après coup dans la même période).
  souscriptionIds     Json
  nombreSouscriptions Int
  primeTotal          Int
  // Virements reçus en règlement, pointés au fil de l'eau (paiements
  // partiels possibles) : [{ montant, date, reference }]
  virements           Json               @default("[]")
  montantRecu         Int                @default(0)
  statut              StatutBordereauImf @default(emis)
  genereParAdminId    String?
  genereParAdmin      Admin?             @relation("AdminBordereauxImf", fields: [genereParAdminId], references: [id])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  imfId               String?
  imf                 Imf?               @relation(fields: [imfId], references: [id])

  @@index([imfId])
}

/**
 * Conditions Générales d'un produit (ou d'une famille de produits), éditables
 * depuis l'espace admin et injectées dans les contrats PDF.
 *
 * `cle` reprend le nom des fichiers statiques historiques ("accident",
 * "incendie"...) : tant qu'aucune ligne n'existe pour une clé, le rendu
 * retombe sur `frontend/public/cg-<cle>.html`. Aucune reprise de données
 * n'est donc nécessaire, et les contrats restent identiques tant que
 * l'administrateur n'a rien saisi (voir services/contractHtml.ts::loadCG).
 */
model ConditionsGenerales {
  cle              String   @id
  libelle          String
  contenuHtml      String
  modifieParAdminId String?
  updatedAt        DateTime @updatedAt
}

// =====================================================================
// API partenaire — clés d'accès, journal des requêtes, idempotence,
// livraison des webhooks sortants. Voir routes/partnerApi.ts,
// src/apiKey.ts, services/partnerWebhook.ts.
// =====================================================================

model PartnerApiKey {
  id             String       @id @default(uuid())
  partenaireId   String
  partenaire     Partenaire   @relation(fields: [partenaireId], references: [id], onDelete: Cascade)
  label          String
  // 16 premiers caractères du secret (ex. "sk_live_a1b2c3d4") — sert à
  // retrouver la ligne sans jamais stocker le secret complet.
  prefix         String       @unique
  // SHA-256 hex du secret complet. Le secret en clair n'est renvoyé qu'une
  // seule fois, à la création (voir POST /partenaires/:id/api-key).
  hash           String
  environnement  EnvApiKey    @default(live)
  // Portées accordées : "catalogue:read", "souscriptions:write",
  // "souscriptions:read", "documents:read".
  scopes         String[]
  // CIDR autorisés (vide = pas de restriction d'IP).
  ipAllowlist    String[]     @default([])
  statut         StatutApiKey @default(active)
  // Endpoint HTTPS du partenaire pour les webhooks sortants + secret de
  // signature HMAC (X-SIM-Signature) + liste des événements souscrits.
  webhookUrl     String?
  webhookSecret  String?
  webhookEvents  String[]     @default([])
  dernierUsageAt DateTime?
  expireAt       DateTime?
  createdAt      DateTime     @default(now())
  revokedAt      DateTime?

  requetes   PartnerApiRequest[]
  livraisons PartnerWebhookDelivery[]

  @@index([partenaireId, statut])
}

model PartnerApiRequest {
  id             String        @id @default(uuid())
  apiKeyId       String
  apiKey         PartnerApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  partenaireId   String
  methode        String
  chemin         String
  statusCode     Int
  ip             String?
  idempotencyKey String?
  souscriptionId String?
  dureeMs        Int
  createdAt      DateTime      @default(now())

  @@index([partenaireId, createdAt])
  @@index([apiKeyId, createdAt])
}

// Rejoue la même réponse si le partenaire renvoie une écriture avec la même
// clé Idempotency-Key (coupure réseau après succès, double tap...).
model IdempotencyRecord {
  cle            String   @id
  apiKeyId       String
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model PartnerWebhookDelivery {
  id                   String        @id @default(uuid())
  apiKeyId             String
  apiKey               PartnerApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  evenement            String
  payload              Json
  url                  String
  tentatives           Int           @default(0)
  // "en_attente" | "livre" | "echec" (abandon après ~24 h de retries).
  statut               String        @default("en_attente")
  prochaineTentativeAt DateTime?
  dernierStatusCode    Int?
  createdAt            DateTime      @default(now())
  livreAt              DateTime?

  @@index([statut, prochaineTentativeAt])
}
