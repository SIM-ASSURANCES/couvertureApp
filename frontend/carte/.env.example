# URL publique du site (SEO, sitemap, liens de partage)
NEXT_PUBLIC_SITE_URL=http://localhost:3000/carte

# Préfixe de publication (défaut « /carte », servi par le frontend couvertureApp). Vide = racine.
# NEXT_PUBLIC_BASE_PATH=/carte

# Styles de fond de carte (MapLibre). Par défaut : CARTO Positron / Dark Matter (données OpenStreetMap).
# En production à fort trafic, utilisez vos propres tuiles (ex. Protomaps/PMTiles auto-hébergé, MapTiler, Stadia).
NEXT_PUBLIC_MAP_STYLE_LIGHT=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
NEXT_PUBLIC_MAP_STYLE_DARK=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
