# Build mobile (Capacitor) : le WebView charge les assets localement
# (https://localhost), il n'y a pas de proxy nginx /api comme sur le site
# web — l'app doit appeler l'API de prod en absolu.
VITE_API_URL=https://protect.mysimassurances.com/api

# Token du QR "unique" du partenaire virtuel "Souscription directe" (voir
# backend/src/seed.ts::TOKEN_QR_DIRECT) — point d'entrée public de l'écran
# d'accueil (Home.tsx) pour souscrire sans intermédiaire.
VITE_DIRECT_QR_TOKEN=app-mobile-direct
